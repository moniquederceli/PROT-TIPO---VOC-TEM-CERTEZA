  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogoNPC
  aberturas:
  - baloes:
    - "Vamos, pode me deixar entrar, voc\xEA com certeza n\xE3o vai querer arrumar
      problemas com "
    - "Meus seguran\xE7as, ou vai?"
    - 'Aqueles estupidos do governo me fizeram sair do meu bunker seguro '
    - "Argh, que nojo de voc\xEAs"
  - baloes:
    - "Pela sua cara com certeza voc\xEA conhece meu marido n\xE3o \xE9?"
    - "Vamos, me deixe entrar logo e n\xE3o trarei problemas para voc\xEA."
    - "Estava segura no meu abrigo e gra\xE7as a seus amiguinhos policiais estou
      aqui com voc\xEAs pobres agora."
  modoDeEscolha: 0
  conversa: []
